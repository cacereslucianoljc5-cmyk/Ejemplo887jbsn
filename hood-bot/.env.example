# ============================================================
# HOOD BOT — Configuración
# Copiá este archivo a `.env` y completá los valores.
# ============================================================

# Token del bot de Telegram (crealo con @BotFather)
TELEGRAM_BOT_TOKEN=

# Clave maestra para cifrar las claves privadas de los usuarios.
# Generá una con: openssl rand -hex 32
# ⚠️ Si la perdés, no se pueden recuperar las billeteras guardadas.
WALLET_ENCRYPTION_KEY=

# --- Red: Robinhood Chain (mainnet) ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Contratos (verificalos en el explorador antes de usar) ---
# Token HOOD (el token que se gasta para comprar). Pegá acá el CA oficial.
HOOD_TOKEN_ADDRESS=

# WETH (wrapped ETH) en Robinhood Chain — el gas de la red es ETH.
WETH_ADDRESS=

# Router estilo Uniswap V2 (Uniswap está desplegado en Robinhood Chain).
# Buscá "UniswapV2Router02" verificado en el explorador o en
# https://docs.uniswap.org/contracts/v2/reference/smart-contracts/v2-deployments
UNISWAP_V2_ROUTER=

# --- Opcionales ---
# Slippage por defecto en puntos básicos (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100
# Montos de compra por defecto (en HOOD), separados por coma
DEFAULT_BUY_AMOUNTS=10,50,100,500
# Carpeta donde se guarda la base de datos cifrada
DATA_DIR=./data
